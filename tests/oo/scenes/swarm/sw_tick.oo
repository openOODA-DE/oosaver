// # Swarm tick
// Logline: per-frame swarm stepping, area scans, and repath helpers.
// Setup: imported by sw_build (SwS, sw_mirror) and scene_swarm (sw_step).
// Beats: swarm_run drives sw_step until bounds and active drain.

import "tests/oo/canvas_cells.oo";
import "tests/oo/kernel/world_ops.oo";
import "tests/oo/kernel/engine_core.oo";
import "tests/oo/kernel/engine_tick.oo";
import "tests/oo/engapi/char_groups.oo";
import "tests/oo/engine/rng_xoshiro.oo";
import "tests/oo/scenes/swarm/sw_geom.oo";

pub type SwS = struct {
    w: World, swarms: Groups, call_next: Int, asa: String, cur: List[Int]
};

type SwF = struct { i: Int, p: String };
type SwN = struct { w: World, asa: String };

pub fn sw_mirror(spec: List[Int]) -> List[Int] {
    let mut out: List[Int] = list_new();
    let mut i: Int = 0;
    while i < list_len(spec) {
        out = list_push(out, list_get(spec, i));
        i = i + 1;
    }
    i = 0;
    while i < 10 {
        out = list_push(out, 15919737);
        i = i + 1;
    }
    i = list_len(spec) - 1;
    while i >= 0 {
        out = list_push(out, list_get(spec, i));
        i = i - 1;
    }
    return out;
}

fn sw_pop(s: SwS) -> SwS {
    let nb: Int = list_len(s.swarms.bounds);
    let cur: List[Int] = grp_win(s.swarms, nb - 1);
    let mut w: World = s.w;
    let mut i: Int = 0;
    while i < list_len(cur) {
        let id: Int = list_get(cur, i);
        w = eng_act_path(w, id, 0);
        w = w_set_vis(w, id, 1);
        w = w_active_add(w, id);
        i = i + 1;
    }
    let mut off: Int = 0;
    let mut j: Int = 0;
    while j < nb - 1 {
        off = off + list_get(s.swarms.bounds, j);
        j = j + 1;
    }
    let g2: Groups = Groups { keys: s.swarms.keys,
        bounds: list_slice(s.swarms.bounds, 0, nb - 1),
        members: list_slice(s.swarms.members, 0, off) };
    let _r1 = SwS { w: w, swarms: g2, call_next: 0, asa: "0_swarm_area", cur: cur };
    return _r1;
}

fn sw_scan(chars: List[Char], cur: List[Int], asa: String) -> SwF {
    let mut nai: Int = 0 - 1;
    let mut nap: String = "";
    let mut i: Int = 0;
    while i < list_len(cur) {
        let id: Int = list_get(cur, i);
        let ch: Char = list_get(chars, id);
        if ch.a_path != 0 - 1 {
            let pid: String = list_get(ch.pids, ch.a_path);
            if pid != asa && has_sub(pid, "swarm_area") == 1 &&
                fdigit(pid) > fdigit(asa) && nai < 0 {
                nai = i;
                nap = pid;
            }
        }
        i = i + 1;
    }
    return SwF { i: nai, p: nap };
}

fn sw_try(w: World, oid: Int, aid: Int, nap: String) -> World {
    let mut w2: World = w;
    if oid != aid {
        let d: DRF = rng_random(w2.rng);
        w2 = w_rng(w2, d.r);
        if d.v < 0.8 {
            let oc: Char = list_get(w2.chars, oid);
            let pi: Int = find_id(oc.pids, nap);
            if pi >= 0 {
                w2 = eng_act_path(w2, oid, pi);
            }
        }
    }
    return w2;
}

fn sw_repath(w: World, cur: List[Int], aid: Int, nap: String) -> World {
    let mut w2: World = w;
    let mut j: Int = 0;
    while j < list_len(cur) {
        let oid: Int = list_get(cur, j);
        w2 = sw_try(w2, oid, aid, nap);
        j = j + 1;
    }
    return w2;
}

pub fn sw_step(s: SwS, info: CanvasInfo) -> SwS {
    let mut s2: SwS = s;
    if list_len(s2.swarms.bounds) > 0 && s2.call_next == 1 {
        s2 = sw_pop(s2);
    }
    let mut w: World = s2.w;
    let mut asa: String = s2.asa;
    let mut call_next: Int = s2.call_next;
    if list_len(w.active) < list_len(s2.cur) {
        call_next = 1;
    }
    if list_len(s2.cur) > 0 {
        let f: SwF = sw_scan(w.chars, s2.cur, asa);
        if f.i >= 0 {
            asa = f.p;
            let aid: Int = list_get(s2.cur, f.i);
            w = sw_repath(w, s2.cur, aid, f.p);
        }
    }
    w = eng_update(w);
    let _r2 = SwS { w: w, swarms: s2.swarms, call_next: call_next, asa: asa, cur: s2.cur };
    return _r2;
}
