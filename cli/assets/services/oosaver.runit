#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 Oosaver
#
# Oosaver Wayland screensaver daemon — runit service.
#
# Install as the desktop user (runit user services live under ~/service):
#
#   mkdir -p ~/service/oosaver/log
#   cp /usr/share/oosaver/services/oosaver.runit ~/service/oosaver/run
#   cp /usr/share/oosaver/services/oosaver.runit-log ~/service/oosaver/log/run
#   chmod 0755 ~/service/oosaver/run ~/service/oosaver/log/run
#
# svlogd is optional: without the log/run script the daemon's output is
# simply discarded by runit.

exec 2>&1
exec /usr/bin/oosaver daemon
