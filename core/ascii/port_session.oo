// # Port Session - Stateful Rust-Parity Scene Driver
//
// Logline: Holds one ported scene's live engine state across preview frames so intro animation and settle match the Rust lifecycle.
// Setup: Pure state threading over the core/ascii bit-exact scene ports. Operates with zero ambient authority.
// Beats:
//   1. Build canvas geometry for the terminal size and lazily construct the scene engine state.
//   2. Each display frame advances the engine by arcade_steps(scene) engine steps, matching Rust ScenePace::Arcade.
//   3. Render the latest frame through the arcade composite pipeline (starfield, gleam, settled banner).

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/port/port_state.oo";
import "core/ascii/port/port_step.oo";
import "port_render.oo";
import "port_compose.oo";

pub type PortSession = struct {
    name: String,
    cols: Int,
    rows: Int,
    last: List[PaintCell],
    settled: Bool,
    tick: Int,
    wm: String,
    st: PortState
};

pub fn port_has(name: String) -> Bool {
    if name == "plasma" || name == "ripple" || name == "aurora" || name == "chaos" { return true; }
    if name == "metaballs" || name == "moire" || name == "cosmos" || name == "radar" { return true; }
    if name == "tunnel" || name == "mystify" || name == "expand" || name == "wipe" { return true; }
    if name == "sweep" || name == "slide" || name == "middleout" || name == "binarypath" { return true; }
    if name == "crumble" || name == "smoke" { return true; }
    if name == "randomsequence" || name == "breakout" || name == "life" || name == "pipes" ||
        name == "tetris" || name == "waves" { return true; }
    if name == "swarm" || name == "unstable" || name == "thunderstorm" { return true; }
    if name == "orbittingvolley" || name == "bubbles" || name == "beams" ||
        name == "laseretch" || name == "print" || name == "rings" ||
        name == "synthgrid" || name == "matrix" || name == "vhstape" { return true; }
    return name == "burn" || name == "blackhole" || name == "rain" || name == "scattered" ||
        name == "pour" || name == "slice" || name == "colorshift" || name == "highlight" ||
        name == "spray" || name == "overflow" || name == "bouncyballs" || name == "decrypt" ||
        name == "fireworks" || name == "spotlights" || name == "errorcorrect";
}

pub fn port_session_new(name: String, cols: Int, rows: Int, wordmark: String, seed: Int) -> PortSession {
    let lines: List[String] = port_lines(wordmark, cols, rows);
    let info: CanvasInfo = art_block(lines, canvas_info(cols, rows));
    let cells: List[CellGeom] = canvas_cells(info, lines);
    let st: PortState = port_state_new(name, cells, info, lines, seed);
    return PortSession {
        name: name, cols: cols, rows: rows,
        last: list_new(), settled: false, tick: 0 - 1, wm: wordmark, st: st
    };
}

pub fn port_session_empty() -> PortSession {
    let info: CanvasInfo = canvas_info(1, 1);
    let cells: List[CellGeom] = list_new();
    let lines: List[String] = list_new();
    return PortSession {
        name: "", cols: 1, rows: 1,
        last: list_new(), settled: true, tick: 0 - 1, wm: "",
        st: port_state_new("", cells, info, lines, 0)
    };
}

pub fn port_session_next(s: PortSession) -> PortSession {
    let mut out: PortSession = s;
    out.tick = s.tick + 1;
    if s.settled { return out; }
    let steps: Int = port_arcade_steps(s.name);
    let mut st: PortState = s.st;
    let mut k: Int = 0;
    let mut eo: EngOut = port_eng_out(st);
    while k < steps && eo.fin == 0 {
        st = port_eng_step(st);
        eo = port_eng_out(st);
        k = k + 1;
    }
    out.st = st;
    if list_len(eo.pcs) > 0 { out.last = eo.pcs; }
    if eo.fin == 1 { out.settled = true; }
    return out;
}

pub fn port_session_frame(s: &PortSession) -> String {
    return port_compose(&s.last, s.cols, s.rows, s.tick, s.settled, s.wm);
}
