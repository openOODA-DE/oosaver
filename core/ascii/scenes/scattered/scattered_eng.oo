// # scattered_eng — incremental engine facade for scattered
//
// Logline: Lazy state/step wrapper so the runtime session advances scattered
// without a pre-rendered tape.
// Setup: Pure compute. Reuses st_build plus the shared engine tick/render.
// Beats:
//   1. scattered_eng_new builds the world and starts the 25-frame hold.
//   2. scattered_eng_step mirrors one run-loop iteration: hold then tick.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/kernel/world_ops.oo";
import "core/ascii/eng/kernel/engine_tick.oo";
import "core/ascii/eng/kernel/engine_render.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "scattered/scene_scattered.oo";

pub type ScEng = struct { w: World, hold: Int, pcs: List[PaintCell],
    emit: Int, fin: Int };

pub fn scattered_eng_new(cells: List[CellGeom], info: CanvasInfo,
                         lines: List[String], seed: Int) -> ScEng {
    let _ = cells;
    let w: World = st_build(w_input(info, lines, rng_seed(seed)), info);
    return ScEng { w: w, hold: 25, pcs: list_new(), emit: 0, fin: 0 };
}

pub fn scattered_eng_step(s: ScEng, info: CanvasInfo) -> ScEng {
    let mut w: World = s.w;
    let mut hold: Int = s.hold;
    if hold != 0 {
        hold = hold - 1;
    } else {
        w = eng_update(w);
    }
    let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
    let f: Int = if list_len(w.active) > 0 { 0 } else { 1 };
    return ScEng { w: w, hold: hold, pcs: pcs, emit: 1, fin: f };
}
