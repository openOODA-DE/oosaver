// # unstable_eng — incremental engine facade for unstable
//
// Logline: Lazy state/step wrapper so the runtime session advances unstable
// without a pre-rendered tape.
// Setup: Pure compute. Reuses us_build/us_step; us_step reports emit itself.
// Beats:
//   1. unstable_eng_new builds the unstable state.
//   2. unstable_eng_step mirrors one run-loop iteration.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "unstable/scene_unstable.oo";
import "unstable/us_build.oo";

pub type UsEng = struct { s: UsS, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn unstable_eng_new(cells: List[CellGeom], info: CanvasInfo,
                        lines: List[String], seed: Int) -> UsEng {
    let _ = cells;
    return UsEng { s: us_build(w_input(info, lines, rng_seed(seed)), info),
        pcs: list_new(), emit: 0, fin: 0 };
}

pub fn unstable_eng_step(s: UsEng, info: CanvasInfo) -> UsEng {
    let r: UsR = us_step(s.s, info);
    if r.emit == 1 {
        return UsEng { s: r.s, pcs: r.pcs, emit: 1, fin: 0 };
    }
    return UsEng { s: r.s, pcs: r.pcs, emit: 0, fin: 1 };
}
