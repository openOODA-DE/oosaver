// # wave_eng — incremental engine facade for the wave family
//
// Logline: Lazy state/step wrappers for plasma, ripple, moire, and tunnel so
// the runtime session advances these scenes without a pre-rendered tape.
// Setup: Pure compute. Reuses each scene's own new/next/advance functions; the
// parity digest driver in each scene page is untouched.
// Beats:
//   1. *_eng_new holds the initial scene state plus frame bookkeeping.
//   2. *_eng_step renders the current state, advances one engine step, and
//      reports emit/fin like the run driver's break-on-empty loop.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "wave/scene_plasma.oo";
import "wave/scene_ripple.oo";
import "wave/scene_moire.oo";
import "wave/scene_tunnel.oo";

pub type PlEng = struct { s: Plasma, pcs: List[PaintCell], emit: Int, fin: Int };
pub type RiEng = struct { s: Ripple, pcs: List[PaintCell], emit: Int, fin: Int };
pub type MoEng = struct { s: Moire, pcs: List[PaintCell], emit: Int, fin: Int };
pub type TuEng = struct { s: Tunnel, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn plasma_eng_new(cells: List[CellGeom], info: CanvasInfo,
                      lines: List[String], seed: Int) -> PlEng {
    let _ = lines;
    let _ = seed;
    return PlEng { s: plasma_new(cells, info), pcs: list_new(), emit: 0, fin: 0 };
}

pub fn plasma_eng_step(s: PlEng, info: CanvasInfo) -> PlEng {
    let _ = info;
    let pcs: List[PaintCell] = plasma_next(s.s);
    if list_len(pcs) == 0 { return PlEng { s: s.s, pcs: pcs, emit: 0, fin: 1 }; }
    return PlEng { s: plasma_advance(s.s), pcs: pcs, emit: 1, fin: 0 };
}

pub fn ripple_eng_new(cells: List[CellGeom], info: CanvasInfo,
                      lines: List[String], seed: Int) -> RiEng {
    let _ = lines;
    let _ = seed;
    return RiEng { s: ripple_new(cells, info), pcs: list_new(), emit: 0, fin: 0 };
