// # metaballs_eng — incremental engine facade for metaballs
//
// Logline: Lazy state/step wrapper so the runtime session advances metaballs
// without a pre-rendered tape.
// Setup: Pure compute. Reuses metaballs_new/next/advance from the scene page;
// the parity digest driver there is untouched.
// Beats:
//   1. metaballs_eng_new holds the initial scene state plus frame bookkeeping.
//   2. metaballs_eng_step renders the current state, advances one engine
//      step, and reports emit/fin like the run driver's break-on-empty loop.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "orbit/scene_metaballs.oo";

pub type MbEng = struct { s: Metaballs, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn metaballs_eng_new(cells: List[CellGeom], info: CanvasInfo,
                         lines: List[String], seed: Int) -> MbEng {
    let _ = lines;
    let _ = seed;
    return MbEng { s: metaballs_new(cells, info), pcs: list_new(), emit: 0, fin: 0 };
}

pub fn metaballs_eng_step(s: MbEng, info: CanvasInfo) -> MbEng {
    let _ = info;
    let pcs: List[PaintCell] = metaballs_next(s.s);
    if list_len(pcs) == 0 { return MbEng { s: s.s, pcs: pcs, emit: 0, fin: 1 }; }
    return MbEng { s: metaballs_advance(s.s), pcs: pcs, emit: 1, fin: 0 };
}
