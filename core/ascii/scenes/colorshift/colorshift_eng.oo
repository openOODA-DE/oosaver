// # colorshift_eng — incremental engine facade for colorshift
//
// Logline: Lazy state/step wrapper so the runtime session advances colorshift
// without a pre-rendered tape.
// Setup: Pure compute. Reuses cs_build/cs_drain plus engine tick/render.
// Beats:
//   1. colorshift_eng_new builds the world and per-char drain counters.
//   2. colorshift_eng_step mirrors one run-loop iteration.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/kernel/world_ops.oo";
import "core/ascii/eng/kernel/engine_ops.oo";
import "core/ascii/eng/kernel/engine_tick.oo";
import "core/ascii/eng/kernel/engine_render.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "colorshift/scene_colorshift.oo";

pub type CsEng = struct { w: World, counts: List[Int], pcs: List[PaintCell],
    emit: Int, fin: Int };

pub fn colorshift_eng_new(cells: List[CellGeom], info: CanvasInfo,
                          lines: List[String], seed: Int) -> CsEng {
    let _ = cells;
    let w: World = cs_build(w_input(info, lines, rng_seed(seed)), info);
    let mut counts: List[Int] = list_new();
    let mut z: Int = 0;
    while z < list_len(w.chars) { counts = list_push(counts, 0); z = z + 1; }
    return CsEng { w: w, counts: counts, pcs: list_new(), emit: 0, fin: 0 };
}

pub fn colorshift_eng_step(s: CsEng, info: CanvasInfo) -> CsEng {
    let w: World = eng_update(s.w);
    let dr: CsD = cs_drain(w, s.counts);
    let pcs: List[PaintCell] = eng_render(dr.w, info.cols, info.rows);
    let f: Int = if list_len(dr.w.active) > 0 { 0 } else { 1 };
    return CsEng { w: dr.w, counts: dr.counts, pcs: pcs, emit: 1, fin: f };
}
