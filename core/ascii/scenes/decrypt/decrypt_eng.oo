// # decrypt_eng — incremental engine facade for decrypt
//
// Logline: Lazy state/step wrapper so the runtime session advances decrypt
// without a pre-rendered tape.
// Setup: Pure compute. Reuses the decrypt builders plus tick/render. The
// parity driver's post-loop activate-and-drain tail is parity-only; the
// runtime holds the last stepped frame.
// Beats:
//   1. decrypt_eng_new builds the world, typing table, and pending order.
//   2. decrypt_eng_step mirrors one run-loop iteration.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/kernel/world_ops.oo";
import "core/ascii/eng/kernel/engine_ops.oo";
import "core/ascii/eng/kernel/engine_tick.oo";
import "core/ascii/eng/kernel/engine_render.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engapi/char_ops.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "core/ascii/eng/engine/rng_helpers.oo";
import "decrypt/scene_decrypt.oo";

pub type DcEng = struct { w: World, pend: List[Int], ids: List[Int],
    pcs: List[PaintCell], emit: Int, fin: Int };

pub fn decrypt_eng_new(cells: List[CellGeom], info: CanvasInfo,
                       lines: List[String], seed: Int) -> DcEng {
    let _ = cells;
    let w0: World = w_input(info, lines, rng_seed(seed));
    let ids: List[Int] = sort_ids(w0, collect_ids(w0, 1), info.cols,
        info.rows, 0);
    let tbl: List[Int] = dc_symtbl();
    let w: World = dc_decrypt(dc_typing(w0, ids, tbl), ids, tbl);
    return DcEng { w: w, pend: list_slice(ids, 0, list_len(ids)), ids: ids,
        pcs: list_new(), emit: 0, fin: 0 };
}

pub fn decrypt_eng_step(s: DcEng, info: CanvasInfo) -> DcEng {
    let mut w: World = s.w;
    let mut pend: List[Int] = s.pend;
    if list_len(pend) > 0 {
        let dg: DR = rng_int(w.rng, 0, 100);
        w = w_rng(w, dg.r);
        if dg.v <= 75 {
            let sw: DcWave = dc_spawn_wave(w, pend);
            w = sw.w;
            pend = sw.queue;
        }
    }
    w = eng_update(w);
    let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
    let f: Int = if list_len(pend) > 0 || list_len(w.active) > 0 { 0 } else { 1 };
    return DcEng { w: w, pend: pend, ids: s.ids, pcs: pcs, emit: 1, fin: f };
}
