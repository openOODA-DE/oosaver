// # slice_eng — incremental engine facade for slice
//
// Logline: Lazy state/step wrapper so the runtime session advances slice
// without a pre-rendered tape.
// Setup: Pure compute. Reuses sz_build plus the shared engine tick/render.
// Beats:
//   1. slice_eng_new builds the world once, at session construction.
//   2. slice_eng_step mirrors one run-loop iteration: tick + render + fin.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/kernel/world_ops.oo";
import "core/ascii/eng/kernel/engine_tick.oo";
import "core/ascii/eng/kernel/engine_render.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "slice/scene_slice.oo";

pub type SzEng = struct { w: World, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn slice_eng_new(cells: List[CellGeom], info: CanvasInfo,
                     lines: List[String], seed: Int) -> SzEng {
    let _ = cells;
    let w: World = sz_build(w_input(info, lines, rng_seed(seed)), info);
    return SzEng { w: w, pcs: list_new(), emit: 0, fin: 0 };
}

pub fn slice_eng_step(s: SzEng, info: CanvasInfo) -> SzEng {
    let w: World = eng_update(s.w);
    let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
    let f: Int = if list_len(w.active) > 0 { 0 } else { 1 };
    return SzEng { w: w, pcs: pcs, emit: 1, fin: f };
}
