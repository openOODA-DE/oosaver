// # randomsequence_eng — incremental engine facade for randomsequence
//
// Logline: Lazy state/step wrapper so the runtime session advances
// randomsequence without a pre-rendered tape.
// Setup: Pure compute. Reuses rs_build/rs_release plus tick/render.
// Beats:
//   1. randomsequence_eng_new builds the world, queue, and chunk size.
//   2. randomsequence_eng_step mirrors one run-loop iteration.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "core/ascii/eng/kernel/world_ops.oo";
import "core/ascii/eng/kernel/engine_tick.oo";
import "core/ascii/eng/kernel/engine_render.oo";
import "core/ascii/eng/engapi/input_arena.oo";
import "core/ascii/eng/engine/float_conv.oo";
import "core/ascii/eng/engine/rng_xoshiro.oo";
import "randomsequence/scene_randomsequence.oo";

pub type RsEng = struct { w: World, pend: List[Int], cpt: Int,
    pcs: List[PaintCell], emit: Int, fin: Int };

pub fn randomsequence_eng_new(cells: List[CellGeom], info: CanvasInfo,
                              lines: List[String], seed: Int) -> RsEng {
    let _ = cells;
    let q: RsQ = rs_build(w_input(info, lines, rng_seed(seed)), info);
    let mut cpt: Int = trunc_i(0.007 * int_to_f(list_len(q.pend)));
    if cpt < 1 { cpt = 1; }
    return RsEng { w: q.w, pend: q.pend, cpt: cpt, pcs: list_new(),
        emit: 0, fin: 0 };
}

pub fn randomsequence_eng_step(s: RsEng, info: CanvasInfo) -> RsEng {
    let q2: RsQ = rs_release(s.w, s.pend, s.cpt);
    let w: World = eng_update(q2.w);
    let pcs: List[PaintCell] = eng_render(w, info.cols, info.rows);
    let f: Int = if list_len(q2.pend) > 0 || list_len(w.active) > 0 { 0 } else { 1 };
    return RsEng { w: w, pend: q2.pend, cpt: s.cpt, pcs: pcs, emit: 1, fin: f };
}
