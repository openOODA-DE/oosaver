// # life_eng — incremental engine facade for life
//
// Logline: Lazy state/step wrapper so the runtime session advances life without
// a pre-rendered tape.
// Setup: Pure compute. Reuses life_new/life_next/life_advance from the scene
// page; the parity digest driver there is untouched.
// Beats:
//   1. life_eng_new holds the initial scene state plus frame bookkeeping.
//   2. life_eng_step renders the current state, advances one engine step, and
//      reports emit/fin like the run driver's break-on-empty loop.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "life/scene_life.oo";

pub type LifeEng = struct { s: Life, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn life_eng_new(cells: List[CellGeom], info: CanvasInfo,
                    lines: List[String], seed: Int) -> LifeEng {
    let _ = lines;
    let _ = seed;
    return LifeEng { s: life_new(cells, info), pcs: list_new(), emit: 0, fin: 0 };
}

pub fn life_eng_step(s: LifeEng, info: CanvasInfo) -> LifeEng {
    let _ = info;
    let pcs: List[PaintCell] = life_next(s.s);
    if list_len(pcs) == 0 { return LifeEng { s: s.s, pcs: pcs, emit: 0, fin: 1 }; }
    return LifeEng { s: life_advance(s.s), pcs: pcs, emit: 1, fin: 0 };
}
