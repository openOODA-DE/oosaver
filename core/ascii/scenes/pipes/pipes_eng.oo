// # pipes_eng — incremental engine facade for pipes
//
// Logline: Lazy state/step wrapper so the runtime session advances pipes without
// a pre-rendered tape.
// Setup: Pure compute. Reuses pipes_new/pipes_next/pipes_advance from the scene
// page; the parity digest driver there is untouched.
// Beats:
//   1. pipes_eng_new holds the initial scene state plus frame bookkeeping.
//   2. pipes_eng_step renders the current state, advances one engine step, and
//      reports emit/fin like the run driver's break-on-empty loop.

import "core/ascii/eng/canvas_cells.oo";
import "core/ascii/eng/grid_cells.oo";
import "pipes/scene_pipes.oo";

pub type PipesEng = struct { s: Pipes, pcs: List[PaintCell], emit: Int, fin: Int };

pub fn pipes_eng_new(cells: List[CellGeom], info: CanvasInfo,
                    lines: List[String], seed: Int) -> PipesEng {
    let _ = lines;
    let _ = seed;
    return PipesEng { s: pipes_new(cells, info), pcs: list_new(), emit: 0, fin: 0 };
}

pub fn pipes_eng_step(s: PipesEng, info: CanvasInfo) -> PipesEng {
    let _ = info;
    let pcs: List[PaintCell] = pipes_next(s.s);
    if list_len(pcs) == 0 { return PipesEng { s: s.s, pcs: pcs, emit: 0, fin: 1 }; }
    return PipesEng { s: pipes_advance(s.s), pcs: pcs, emit: 1, fin: 0 };
}
