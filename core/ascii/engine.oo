// # Scene Engine - Frame Pipeline, Tour Scheduling, Wordmark Overlay
//
// Logline: The frame pipeline: render the active scene, lay the bevelled OS/custom wordmark banner, post-FX, HUD, and ANSI out.
// Setup: Pure pipeline over CellGrid. Scene frames come from the 1:1 bit-exact ported engines in tests/oo via PortSession. Output strings are produced; emission is the caller's job.
// Beats:
//   1. Resolve the scene index from name or tour schedule.
//   2. Step a PortSession to the tick and composite its PaintCell tape (settled banner, post-FX).
//   3. Render preview HUD and serialise the finished grid to ANSI for the presenter.

import "core/cell.oo";
import "core/grid.oo";
import "core/ascii/port_session.oo";
import "core/ascii/port_compose.oo";
import "core/ascii/draw/anchor.oo";
import "core/ascii/layout/anchor.oo";
import "core/raster/glyph_hud.oo";

pub fn engine_session_grid(ps: PortSession) -> CellGrid {
    return port_compose_grid(&ps.last, ps.cols, ps.rows, ps.tick, ps.settled, ps.wm);
}

pub fn engine_preview_session(ps: PortSession, scene_idx: Int, tour: Bool) -> String {
    let mut g: CellGrid = engine_session_grid(ps);
    g = draw_preview_hud(g, ps.name, scene_idx + 1, 51, tour);
    return ansi_frame(g);
}

pub fn engine_tour_index(tick: Int, scene_secs: Int) -> Int {
    let mut s: Int = scene_secs;
    if s <= 0 { s = 10; }
    return (tick / s) % 51;
}

pub fn engine_wordmark_frame(cols: Int, rows: Int, name: String, tick: Int) -> String {
    let mut g: CellGrid = grid_new(cols, rows, rgb(4, 6, 12));
    g = wm_render(g, name, tick);
    g = post_apply(g, tick);
    return ansi_frame(g);
}
